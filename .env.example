# Operational overrides only; never commit a populated .env file.
BUDGETROUTE_OUTPUT_DIR=outputs
BUDGETROUTE_HOST=127.0.0.1
BUDGETROUTE_PORT=8000
BUDGETROUTE_LOG_LEVEL=info
# Generate a unique value in your secret manager; this placeholder is intentionally unusable.
BUDGETROUTE_API_KEY=replace-with-a-random-secret
# Optional multi-tenant JSON. Inject the real value from a secret manager instead of this file.
# BUDGETROUTE_TENANT_KEYS_JSON={"tenants":[{"tenant_id":"team-a","subject":"service-a","api_key":"replace-with-a-random-32-byte-secret","scopes":["inference"]}]}
BUDGETROUTE_REPLICA_ID=local-replica-1
HF_HOME=model-cache
